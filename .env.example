# ── Supabase (local : valeurs affichées par `supabase start`) ──
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Serveur uniquement (Edge Functions, serveur admin). Jamais dans une variable publique.
SUPABASE_SERVICE_ROLE_KEY=

# ── Clients publics ──
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth ──
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=            # serveur uniquement (révocation des jetons)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=         # serveur uniquement

# ── Prestataires (Edge Functions uniquement ; vide = adaptateur mock) ──
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
LLM_PROVIDER=mock             # mock | mistral
MISTRAL_API_KEY=
VERIFICATION_PROVIDER=mock    # mock | veriff | ubble | onfido
VERIFICATION_API_KEY=
VERIFICATION_WEBHOOK_SECRET=
RESEND_API_KEY=
CIRCLE_HMAC_KEY=              # clé applicative du cercle masqué
CIRCLE_PEPPER=                # poivre serveur (Vault en prod)

# ── Notifications ──
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=            # serveur uniquement

# ── Observabilité ──
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Environnement ──
APP_ENV=local                 # local | staging | production
